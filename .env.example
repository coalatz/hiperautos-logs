# Copie este arquivo para .env e preencha com suas credenciais
# cp .env.example .env

# URL da API Groq (chat completions)
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Sua chave de API do Groq
# Obtenha em: https://console.groq.com/keys
GROQ_API_KEY=seu_groq_api_key_aqui

# Opcional: alterar credenciais do Grafana (padrão: admin/admin)
# GF_SECURITY_ADMIN_PASSWORD=sua_senha_aqui
